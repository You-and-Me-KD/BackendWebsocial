{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/users/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "swc",
    "webpack": true,
    "tsConfigPath": "apps/users/tsconfig.app.json"
  },
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "users": {
      "type": "application",
      "root": "apps/users",
      "entryFile": "main",
      "sourceRoot": "apps/users/src",
      "compilerOptions": {
        "tsConfigPath": "apps/users/tsconfig.app.json"
      }
    },
    "auths": {
      "type": "application",
      "root": "apps/auths",
      "entryFile": "main",
      "sourceRoot": "apps/auths/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auths/tsconfig.app.json"
      }
    },
    "files": {
      "type": "application",
      "root": "apps/files",
      "entryFile": "main",
      "sourceRoot": "apps/files/src",
      "compilerOptions": {
        "tsConfigPath": "apps/files/tsconfig.app.json"
      }
    },
    "socials": {
      "type": "application",
      "root": "apps/socials",
      "entryFile": "main",
      "sourceRoot": "apps/socials/src",
      "compilerOptions": {
        "tsConfigPath": "apps/socials/tsconfig.app.json"
      }
    },
    "chats": {
      "type": "application",
      "root": "apps/chats",
      "entryFile": "main",
      "sourceRoot": "apps/chats/src",
      "compilerOptions": {
        "tsConfigPath": "apps/chats/tsconfig.app.json"
      }
    },
    "notifications": {
      "type": "application",
      "root": "apps/notifications",
      "entryFile": "main",
      "sourceRoot": "apps/notifications/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notifications/tsconfig.app.json"
      }
    },
    "groups": {
      "type": "application",
      "root": "apps/groups",
      "entryFile": "main",
      "sourceRoot": "apps/groups/src",
      "compilerOptions": {
        "tsConfigPath": "apps/groups/tsconfig.app.json"
      }
    },
    "marketplaces": {
      "type": "application",
      "root": "apps/marketplaces",
      "entryFile": "main",
      "sourceRoot": "apps/marketplaces/src",
      "compilerOptions": {
        "tsConfigPath": "apps/marketplaces/tsconfig.app.json"
      }
    }
  },
  "monorepo": true,
  "root": "apps/users"
}